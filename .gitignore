# установочные файлы программ — большие (сотни МБ), у каждого свои источники,
# в репозиторий не кладём (см. installers/<id>/ПОЛОЖИТЕ_ФАЙЛ_СЮДА.txt)
installers/*
!installers/.gitkeep

__pycache__/
*.pyc

# служебное
*.zip

# служебное окружение агента/IDE — не часть проекта
.claude/
installers__old/

# секрет автообновления — только на установленной копии, не в репозитории
.update_token
